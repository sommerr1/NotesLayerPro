{
  "manifest_version": 3,
  "name": "Notes Layer Pro",
  "version": "1.0.0",
  "description": "Inline notes and AI clarification on web pages",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "tabs",
    "scripting",
    "downloads"
  ],
  "optional_permissions": [
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/quill.min.js",
        "content/anchor.js",
        "content/highlighter.js",
        "content/note-card.js",
        "content/content.js"
      ],
      "css": [
        "ui/note-card.css",
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/note-card.html",
        "lib/quill.min.js",
        "lib/quill.snow.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
